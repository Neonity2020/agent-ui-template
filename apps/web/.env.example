# Neon PostgreSQL connection string
# Create a database at https://console.neon.tech and copy the connection string.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Better Auth secret — generate one with: npx better-auth secret
BETTER_AUTH_SECRET=

# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
