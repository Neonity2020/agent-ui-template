{
  "name": "agent-ui-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-ui/web dev",
    "dev:local": "pnpm --parallel --stream --filter @agent-ui/web --filter @agent-ui/local-runner run dev:local",
    "build": "pnpm --filter @agent-ui/web build",
    "start": "pnpm --filter @agent-ui/web start",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
